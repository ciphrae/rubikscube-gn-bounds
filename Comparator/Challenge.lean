theorem main_explicit' (μ : Metric) (n : ℕ) :
    (2 ^ 8 ≤ n → (godLabelled μ n : ℝ) ≤ 466 * (n : ℝ) ^ 2 / Real.logb 2 n) ∧
    (2 ^ 9 ≤ n → (godLabelled μ n : ℝ) ≤ 298 * (n : ℝ) ^ 2 / Real.logb 2 n) ∧
