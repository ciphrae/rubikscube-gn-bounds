/-- Integer vectors: stickers live on the surface of the cube `[-n,n]³`. -/
abbrev V := ℤ × ℤ × ℤ

/-- The 24 proper signed permutation matrices (index `0` is the identity). -/
def actN : ℕ → V → V
  | 0, (x, y, z) => (x, y, z)
  | 1, (x, y, z) => (x, -z, y)
  | 2, (x, y, z) => (z, y, -x)
  | 3, (x, y, z) => (-y, x, z)
  | 4, (x, y, z) => (x, -y, -z)
  | 5, (x, y, z) => (y, -z, -x)
  | 6, (x, y, z) => (z, x, y)
  | 7, (x, y, z) => (-x, y, -z)
  | 8, (x, y, z) => (-y, z, -x)
  | 9, (x, y, z) => (-y, -z, x)
  | 10, (x, y, z) => (-x, -y, z)
  | 11, (x, y, z) => (x, z, -y)
  | 12, (x, y, z) => (-z, -y, -x)
  | 13, (x, y, z) => (y, x, -z)
  | 14, (x, y, z) => (-x, -z, -y)
  | 15, (x, y, z) => (z, -y, x)
  | 16, (x, y, z) => (-x, z, y)
  | 17, (x, y, z) => (-z, y, x)
  | 18, (x, y, z) => (-y, -x, -z)
  | 19, (x, y, z) => (y, -x, z)
  | 20, (x, y, z) => (-z, x, -y)
  | 21, (x, y, z) => (y, z, x)
  | 22, (x, y, z) => (z, -x, -y)
  | 23, (x, y, z) => (-z, -x, y)
  | _, v => v

